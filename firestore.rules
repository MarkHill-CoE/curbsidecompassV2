rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for hardened validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSurveyResponse(data) {
      return data.personaId is string
        && data.personaId.size() <= 50
        && data.personaTitle is string
        && data.personaTitle.size() <= 100
        && data.quadrant in ['Q1', 'Q2', 'Q3', 'Q4']
        && (data.totalX is number && data.totalX >= -50 && data.totalX <= 50)
        && (data.totalY is number && data.totalY >= -50 && data.totalY <= 50)
        && (data.feedback == null || (data.feedback is string && data.feedback.size() <= 600))
        && (data.rating == null || ((data.rating is int || data.rating is number) && data.rating >= 1 && data.rating <= 5))
        && (data.postalCode == null || (data.postalCode is string && data.postalCode.size() <= 20))
        && (data.fsa == null || (data.fsa is string && data.fsa.size() <= 10));
    }

    // Curbside Compass public survey responses
    // Citizens and respondents can submit and update their own feedback session
    match /survey_responses/{responseId} {
      allow create: if isValidId(responseId)
                    && isValidSurveyResponse(request.resource.data);
      allow update: if isValidId(responseId)
                    && resource != null
                    && isValidSurveyResponse(request.resource.data);
      allow read, delete: if false; // Private to project administrators in Firebase Console
    }

    // Connection validation endpoint for client health check
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
  }
}
